## ===== Parse arguments =====
args <- commandArgs(trailingOnly = TRUE)
if (length(args) < 4) {
  stop("Usage: Rscript run_pair_mag.R model1.RDS model2.RDS diet.xlsx output_dir")
}

model1_file <- args[1]
model2_file <- args[2]
diet_file   <- args[3]
output_root <- args[4]

## ===== Load libraries =====
library(lattice)
library(ReacTran)
library(rootSolve)
library(deSolve)
library(shape)
library(sybil)
library(Matrix)
library(BacArena)
library(parallel)
library(openxlsx)
library(cobrar)
library(cplexAPI)

SYBIL_SETTINGS("SOLVER", "cplexAPI")

source("/scratch/users/nus/e1583595/Rmodel/cobrar2sybil.R")

## ===== Load models =====
m1_raw <- readRDS(model1_file)
m2_raw <- readRDS(model2_file)

adjust_one_model <- function(model) {

  if ("react_name" %in% slotNames(model)) {
    rn <- model@react_name
  } else {
    rn <- sybil::react_name(model)
  }

  if ("lowbnd" %in% slotNames(model)) {
    lb <- model@lowbnd
    write_back <- function(newlb) { model@lowbnd <<- newlb }
  } else {
    lb <- sybil::lowbnd(model)
    write_back <- function(newlb) { sybil::lowbnd(model) <<- newlb }
  }

 }

m1 <- cobrar2sybil(m1_raw)
m2 <- cobrar2sybil(m2_raw)
m1 <- adjust_one_model(m1)
m2 <- adjust_one_model(m2)
sp1 <- tools::file_path_sans_ext(basename(model1_file))
sp2 <- tools::file_path_sans_ext(basename(model2_file))
pair_name <- paste0(sp1, "_", sp2)

## ===== Output directory =====
output_pair <- file.path(output_root, pair_name)
if (dir.exists(output_pair)) {
  cat("Directory already exists, skip task:", output_pair, "\n")
  quit(save = "no")
}

dir.create(output_pair, showWarnings = FALSE, recursive = TRUE)

## ===== Load diet =====
diet <- read.xlsx(diet_file, sheet = 1)

## ===== Simulation settings =====
grid_no  <- 30
death_r  <- 0
inocc_no <- 0.05
iter_no  <- 10

## ===== Create Bac objects =====
bac1 <- Bac(model = m1, lyse = TRUE, deathrate = death_r, speed = 2,
            maxweight = 1.172, minweight = 0.125, growtype = "exponential",
            setAllExInf = FALSE, limit_growth = TRUE)

bac2 <- Bac(model = m2, lyse = FALSE, deathrate = death_r, speed = 2,
            maxweight = 1.172, minweight = 0.125, growtype = "exponential",
            setAllExInf = FALSE, limit_growth = TRUE)

## ===== Function to run one replicate =====
run_once <- function(rep_id) {

  outdir <- file.path(output_pair, paste0("run", rep_id))
  dir.create(outdir, showWarnings = FALSE, recursive = TRUE)

  arena <- Arena(n = grid_no, m = grid_no)

  cells1 <- round(grid_no * grid_no * inocc_no)
  cells2 <- round(grid_no * grid_no * inocc_no)

  arena <- addOrg(arena, bac1, amount = cells1)
  arena <- addOrg(arena, bac2, amount = cells2)

  arena <- addSubs(arena,
                   mediac = diet$Exchange,
                   smax   = diet$Input_mM,
                   unit   = "mM",
                   add    = FALSE)

  arena@tstep <- 1

  sim <- simEnv(object = arena, time = iter_no,
                sec_obj = "mtf", continue = TRUE)

  saveRDS(sim, file.path(outdir, "simulation.RDS"))

  ## Biomass curve
  gc_bio <- plotGrowthCurve(sim, use_biomass = TRUE, ret_data = TRUE)
  write.csv(gc_bio, file.path(outdir, "growth_biomass.csv"), row.names = FALSE)

  pdf(file.path(outdir, "growth_biomass.pdf"), width=6, height=5)
  plotGrowthCurve(sim, use_biomass = TRUE)
  dev.off()

  ## Number curve
  gc_num <- plotGrowthCurve(sim, use_biomass = FALSE, ret_data = TRUE)
  write.csv(gc_num, file.path(outdir, "growth_number.csv"), row.names = FALSE)

  pdf(file.path(outdir, "growth_number.pdf"), width=6, height=5)
  plotGrowthCurve(sim, use_biomass = FALSE)
  dev.off()

  ## Exchange flux
  last_t <- iter_no
  ex <- sim@exchangeslist[[last_t]]
  write.csv(ex, file.path(outdir, "exchange.csv"), row.names = FALSE)

  ## Return final biomass + number
  fb <- tail(gc_bio$biomass, 1)
  fn <- tail(gc_num$number, 1)

  return(list(final_biomass = fb, final_number = fn))
}

## ===== Run 3 replicates =====
r1 <- run_once(1)
