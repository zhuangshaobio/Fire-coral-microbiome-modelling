args <- commandArgs(trailingOnly = TRUE)
if (length(args) < 3) {
  stop("Usage: Rscript run_bacarena_single.R model_file diet.xlsx output_dir")
}

model_file <- args[1]
diet_file  <- args[2]
output_dir <- args[3]

library(lattice)
library(ReacTran)
library(rootSolve)
library(deSolve)
library(shape)
library(sybil)
library(Matrix)
library(BacArena)
library(parallel)
library(openxlsx)
library(cobrar)
library(cplexAPI)

SYBIL_SETTINGS("SOLVER", "cplexAPI")

source("/scratch/users/nus/e1583595/Rmodel/cobrar2sybil.R")

b_raw <- readRDS(model_file)
model <- cobrar2sybil(b_raw)

adjust_one_model <- function(model) {

  if ("react_name" %in% slotNames(model)) {
    rn <- model@react_name
  } else {
    rn <- sybil::react_name(model)
  }

  if ("lowbnd" %in% slotNames(model)) {
    lb <- model@lowbnd
    write_back <- function(newlb) { model@lowbnd <<- newlb }
  } else {
    lb <- sybil::lowbnd(model)
    write_back <- function(newlb) { sybil::lowbnd(model) <<- newlb }
  }
}

model <- adjust_one_model(model)

species_name <- tools::file_path_sans_ext(basename(model_file))

diet <- read.xlsx(diet_file, sheet = 1)

output_root  <- normalizePath(output_dir, mustWork = FALSE)
output_model <- file.path(output_root, species_name)
dir.create(output_model, showWarnings = FALSE, recursive = TRUE)

grid_no  <- 30
death_r  <- 0.05
Inocc_no <- 0.05
iter_no  <- 12

bac_obj <- Bac(
  model        = model,
  lyse         = TRUE,
  speed        = 2,
  deathrate    = death_r,
  maxweight    = 1.172,
  minweight    = 0.125,
  growtype     = "exponential",
  setAllExInf  = FALSE,
  limit_growth = TRUE
)

run_once <- function(run_id) {

  arena <- Arena(n = grid_no, m = grid_no)
  inocc <- grid_no * grid_no * Inocc_no

  arena <- addOrg(arena, bac_obj, amount = inocc)

  arena <- addSubs(
    object = arena,
    mediac = diet$Exchange,
    smax   = diet$Input_mM,
    unit   = "mM",
    add    = FALSE
  )

  arena@tstep <- 1

  sim <- simEnv(
    object   = arena,
    time     = iter_no,
    sec_obj  = "mtf",
    continue = TRUE
  )

  saveRDS(
    sim,
    file.path(output_model,
              paste0(species_name, "_run", run_id, "_simulation.RDS"))
  )

  g_bio <- plotGrowthCurve(sim, use_biomass = TRUE,  ret_data = TRUE)
  g_num <- plotGrowthCurve(sim, use_biomass = FALSE, ret_data = TRUE)

  write.csv(g_bio,
            file.path(output_model, paste0("run", run_id, "_biomass.csv")),
            row.names = FALSE)

  write.csv(g_num,
            file.path(output_model, paste0("run", run_id, "_number.csv")),
            row.names = FALSE)

  tail(g_bio$biomass, 1)
}

final1 <- run_once(1)
final2 <- run_once(2)
final3 <- run_once(3)
